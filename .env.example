# Exemplo para desenvolvimento isolado. Não copie credenciais reais para este arquivo.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PORT=3001

# Barreira de acesso (obrigatória fora do loopback). Valores do painel Cloudflare Zero Trust:
# CF_ACCESS_TEAM_DOMAIN=<time>.cloudflareaccess.com
# CF_ACCESS_AUD=<Application Audience (AUD) Tag>
# CF_ACCESS_ALLOWED_EMAILS=voce@exemplo.com

# Somente desenvolvimento local, com HOST=127.0.0.1:
# GARAGE_ACCESS_DISABLED=local-only
# HOST=127.0.0.1
